# Rahkaran SQL Server (read-only)
RAHKARAN_DB_SERVER=your-sql-server
RAHKARAN_DB_NAME=your-database
RAHKARAN_DB_USER=your-readonly-user
RAHKARAN_DB_PASSWORD=your-password
RAHKARAN_DB_ENCRYPT=true
RAHKARAN_DB_TRUST_SERVER_CERTIFICATE=true

# App metadata database (Prisma)
DATABASE_URL="sqlserver://localhost:1433;database=InsightPortal;user=sa;password=YourStrong!Passw0rd;encrypt=true;trustServerCertificate=true"

# Auth (NextAuth / Auth.js)
AUTH_SECRET=replace-with-a-long-random-secret
NEXTAUTH_URL=http://localhost:3000

# Optional EXTRA secret for sync-users (in addition to admin login)
# If set, requests must also send header: x-admin-secret: <value>
ADMIN_SYNC_SECRET=

# Optional fallbacks before first-time /setup wizard
NEXT_PUBLIC_APP_NAME=Insight Portal
NEXT_PUBLIC_COMPANY_NAME=

# Seed defaults (only if you run npm run db:seed — wizard also creates admin)
SEED_ADMIN_USER=admin
SEED_ADMIN_PASSWORD=admin123

# Email delivery — scheduled reports (npm run schedules:run) AND the
# Notification Center's digest (npm run notifications:digest). Optional;
# without it, both features still run and just skip sending mail.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=reports@company.com

# Finance copilot — local LLM only (no cloud API, no per-query cost).
# Point at an Ollama instance; pick a model that fits the server's real
# hardware (7-8B if CPU-only/modest RAM, 14B+ with a real GPU) and that
# supports Ollama tool calling. Validate against real questions before
# trusting it in production.
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:14b-instruct

# Only needed for the payables-commitment rules in npm run scan — see README.
# Two SL (معین) codes specific to this customer's chart of accounts.
PAYABLES_WATCH_SL_CODES=
