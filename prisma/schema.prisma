generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlserver"
  url      = env("DATABASE_URL")
}

model User {
  id             String   @id @default(cuid())
  rahkaranUserId BigInt?  @unique
  username       String   @unique
  displayName    String?
  email          String?
  passwordHash   String?
  domainUserName String?
  isAdmin        Boolean  @default(false)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  moduleAccess UserModuleAccess[]
  reportAccess UserReportAccess[]
  auditLogs  AuditLog[]
  roles          UserRole[]
  savedViews     SavedReportView[]
  favorites      ReportFavorite[]
  schedules      ReportSchedule[]
  notifications  Notification[]
  locale         String   @default("fa")
}

model ReportModule {
  id          String   @id @default(cuid())
  slug        String   @unique
  nameFa      String
  description String?
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  reports    Report[]
  folders    ReportFolder[]
  rdlReports RdlReport[]
  userAccess UserModuleAccess[]
  roleAccess RoleModuleAccess[]
}

model ReportFolder {
  id             String        @id @default(cuid())
  moduleId       String
  module         ReportModule  @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  parentFolderId String?
  parentFolder   ReportFolder? @relation("FolderTree", fields: [parentFolderId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  childFolders   ReportFolder[] @relation("FolderTree")
  nameFa         String
  sortOrder      Int           @default(0)
  isActive       Boolean       @default(true)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  reports Report[]

  @@index([moduleId])
  @@index([parentFolderId])
}

model DataSource {
  id             String   @id @default(cuid())
  slug           String   @unique
  nameFa         String
  type           String   @default("sqlserver")
  /// Env-var based connection key, e.g. "rahkaran" | "attendance"
  providerKey    String
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  reports Report[]
}

model Report {
  id             String   @id @default(cuid())
  slug           String   @unique
  nameFa         String
  moduleId       String
  module         ReportModule @relation(fields: [moduleId], references: [id])
  folderId       String?
  folder         ReportFolder? @relation(fields: [folderId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  dataSourceId   String?
  dataSource     DataSource?  @relation(fields: [dataSourceId], references: [id])
  /// Relative path under src/lib/reports/sql/
  sqlFile        String?
  /// Inline SQL when edited in Studio (takes precedence over sqlFile when set and published)
  sqlQuery       String?  @db.NVarChar(Max)
  /// Full ReportDefinition JSON document
  definition     String?  @db.NVarChar(Max)
  publishedVersion Int    @default(1)
  isActive       Boolean  @default(true)
  sortOrder      Int      @default(0)
  /// studio | package | rdl
  sourceType     String   @default("studio")
  /// RDL row id, import filename note, etc.
  sourceRef      String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  versions   ReportVersion[]
  userAccess UserReportAccess[]
  roleAccess RoleReportAccess[]
  auditLogs  AuditLog[]
  rdlSources RdlReport[]
}

/// Uploaded SSRS/RDL report (legacy) — view metadata and convert to Insight report
model RdlReport {
  id               String   @id @default(cuid())
  slug             String   @unique
  nameFa           String
  originalFilename String
  storageName      String
  /// Parsed summary JSON (parameters, datasets, layout)
  parsedMeta       String   @db.NVarChar(Max)
  moduleId         String?
  module           ReportModule? @relation(fields: [moduleId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  /// If converted, linked native report slug (legacy)
  convertedReportSlug String?
  /// FK to native Report row
  convertedReportId   String?
  convertedReport     Report?  @relation(fields: [convertedReportId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  /// uploaded | converted | failed | needs_review
  convertStatus     String   @default("uploaded")
  convertError      String?
  uploadedBy       String?
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([moduleId])
  @@index([convertedReportId])
}

model Role {
  id        String   @id @default(cuid())
  slug      String   @unique
  nameFa    String
  createdAt DateTime @default(now())

  users         UserRole[]
  moduleAccess  RoleModuleAccess[]
  reportAccess  RoleReportAccess[]
}

model UserRole {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  roleId    String
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, roleId])
}

model RoleModuleAccess {
  id        String   @id @default(cuid())
  roleId    String
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  moduleId  String
  module    ReportModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  canView   Boolean  @default(true)
  createdAt DateTime @default(now())

  @@unique([roleId, moduleId])
}

model RoleReportAccess {
  id        String   @id @default(cuid())
  roleId    String
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  reportId  String
  report    Report   @relation(fields: [reportId], references: [id], onDelete: Cascade)
  canView   Boolean  @default(true)
  canExport Boolean  @default(true)
  createdAt DateTime @default(now())

  @@unique([roleId, reportId])
}

model SavedReportView {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  reportSlug String
  nameFa     String
  parameters String   @db.NVarChar(Max)
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([userId, reportSlug])
}

model ReportFavorite {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  reportSlug String
  createdAt  DateTime @default(now())

  @@unique([userId, reportSlug])
}

model ReportSchedule {
  id           String    @id @default(cuid())
  reportSlug   String
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  nameFa       String
  /// daily | weekly | monthly
  frequency    String    @default("daily")
  /// HH:mm 24h
  runAt        String    @default("08:00")
  parameters   String    @db.NVarChar(Max)
  format       String    @default("excel")
  recipients   String    @db.NVarChar(Max)
  isActive     Boolean   @default(true)
  lastRunAt    DateTime?
  lastRunStatus String?
  lastRunError  String?   @db.NVarChar(Max)
  nextRunAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([isActive, nextRunAt])
}

model ReportVersion {
  id          String   @id @default(cuid())
  reportId    String
  report      Report   @relation(fields: [reportId], references: [id], onDelete: Cascade)
  version     Int
  definition  String   @db.NVarChar(Max)
  sqlSnapshot String?  @db.NVarChar(Max)
  note        String?
  createdBy   String?
  createdAt   DateTime @default(now())

  @@unique([reportId, version])
}

model LookupCatalog {
  id          String   @id @default(cuid())
  slug        String   @unique
  nameFa      String
  description String?
  /// Must return Code, Label columns
  lookupSql   String   @db.NVarChar(Max)
  dataSourceKey String  @default("rahkaran")
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model UserModuleAccess {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  moduleId  String
  module    ReportModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  canView   Boolean  @default(true)
  createdAt DateTime @default(now())

  @@unique([userId, moduleId])
}

model UserReportAccess {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  reportId  String
  report    Report   @relation(fields: [reportId], references: [id], onDelete: Cascade)
  canView   Boolean  @default(true)
  canExport Boolean  @default(true)
  createdAt DateTime @default(now())

  @@unique([userId, reportId])
}

model DashboardWidget {
  id        String   @id @default(cuid())
  title     String
  type      String
  config    String   @db.NVarChar(Max)
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  action     String
  reportId   String?
  report     Report?  @relation(fields: [reportId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  parameters String?  @db.NVarChar(Max)
  durationMs Int?
  success    Boolean  @default(true)
  message    String?  @db.NVarChar(Max)
  createdAt  DateTime @default(now())
}

/// A finding a human has reviewed and dismissed — "this is fine, stop flagging it".
/// Keyed by rule + the specific record, not the whole rule, so accepting one
/// legitimate case never hides the rest of that rule's real findings.
model RuleException {
  id        String   @id @default(cuid())
  ruleId    String
  /// Matches RuleFindingRow.entity_id, always stored as text.
  entityId  String
  note      String?
  createdBy String?
  createdAt DateTime @default(now())

  @@unique([ruleId, entityId])
  @@index([ruleId])
}

/// Persisted configuration for a rule — either wrapping a code-defined Rule
/// (src/lib/rules/packs/*.ts, kind "predefined", created lazily the first
/// time the rules admin page or a scheduled run touches it) or a
/// business-user-authored rule built in the Entity Rule Builder (kind
/// "custom" — Phase 4 of docs/architecture/management-intelligence-platform.md
/// §14). `ruleCode` stays required+unique either way — a custom rule gets a
/// synthetic "custom.<id>" code — so every other table that keys off it
/// (RuleRun, RuleFinding, notification links) doesn't need to know which
/// kind it's looking at.
model RuleDefinition {
  id         String   @id @default(cuid())
  /// predefined | custom
  kind       String   @default("predefined")
  /// Matches Rule.id from src/lib/rules/packs for "predefined"; synthetic "custom.<id>" for "custom".
  ruleCode   String   @unique
  /// custom only — display name (predefined rules get titleFa from the pack).
  titleFa    String?
  /// custom only — which BusinessEntityDef (src/lib/entities/) this rule reads.
  entityKey  String?
  /// custom only — the ConditionNode tree (src/lib/entities/condition.ts), JSON.
  conditionJson String? @db.NVarChar(Max)
  /// custom only — critical | high | medium | low (predefined rules get severity from the pack).
  severity   String?
  createdBy  String?
  isEnabled  Boolean  @default(true)
  /// Threshold overrides for the rule's RuleParam[]. JSON Record<string, number>.
  paramsJson String?  @db.NVarChar(Max)
  /// daily | hourly | weekly
  frequency  String   @default("daily")
  /// HH:mm 24h
  runAt      String   @default("07:00")
  lastRunAt  DateTime?
  nextRunAt  DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  runs     RuleRun[]
  findings RuleFinding[]

  @@index([isEnabled, nextRunAt])
}

/// One row per execution of a RuleDefinition — history for the admin UI and
/// for diagnosing a schedule that stopped working.
model RuleRun {
  id            String         @id @default(cuid())
  ruleDefId     String
  ruleDef       RuleDefinition @relation(fields: [ruleDefId], references: [id], onDelete: Cascade)
  runAt         DateTime       @default(now())
  durationMs    Int
  /// ok | error
  status        String
  findingCount  Int            @default(0)
  newCount      Int            @default(0)
  resolvedCount Int            @default(0)
  totalAmount   Float?
  error         String?        @db.NVarChar(Max)
  /// "schedule" | "manual:<userId>"
  triggeredBy   String?

  @@index([ruleDefId, runAt])
}

/// The lifecycle state of one still-relevant finding for one rule + entity.
/// Distinct from RuleException (a permanent "this row is fine, stop flagging
/// it" whitelist): this tracks whether a currently-valid finding is new,
/// has been looked at, or has resolved itself since the last run.
model RuleFinding {
  id             String         @id @default(cuid())
  ruleDefId      String
  ruleDef        RuleDefinition @relation(fields: [ruleDefId], references: [id], onDelete: Cascade)
  /// Matches RuleFindingRow.entity_id, always stored as text.
  entityId       String
  /// new | acknowledged | resolved
  status         String         @default("new")
  severity       String
  titleFa        String
  detailFa       String         @db.NVarChar(Max)
  amount         Float?
  refDate        DateTime?
  firstSeenAt    DateTime       @default(now())
  lastSeenAt     DateTime       @updatedAt
  resolvedAt     DateTime?
  resolvedBy     String?
  acknowledgedAt DateTime?
  acknowledgedBy String?

  @@unique([ruleDefId, entityId])
  @@index([ruleDefId, status])
}

/// One row per (user, event) — a finding turning "new" or reopening notifies
/// every active admin individually, so read/unread state is per-person, not
/// a single shared flag. Phase 2 of docs/architecture/management-intelligence-platform.md.
model Notification {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// critical | high | medium | low | info
  severity   String
  title      String
  body       String    @db.NVarChar(Max)
  /// "rule_finding" today; other sources (schedule_failure, …) can reuse this table later.
  sourceType String
  sourceId   String?
  linkHref   String?
  readAt     DateTime?
  /// Set once this row has been folded into an email digest, so the digest job never repeats itself.
  emailedAt  DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId, readAt])
  @@index([userId, createdAt])
}

/// A materialized snapshot of one Business Entity's current rows — Phase 3 of
/// docs/architecture/management-intelligence-platform.md §5/§8. Populated by
/// syncEntity() (src/lib/entities/sync.ts) immediately before an
/// entity-backed rule evaluates; this is a pull-based snapshot, not a live
/// view or a change-tracked history. `data` holds the entity definition's
/// typed fields as JSON — deliberately generic (no per-entity table) since
/// Phase 3 only has one entity; promote to a physical table if/when an
/// entity's query volume actually needs it (see §5.2).
model EntityRecord {
  id          String   @id @default(cuid())
  entityKey   String
  externalId  String
  data        String   @db.NVarChar(Max)
  firstSeenAt DateTime @default(now())
  lastSeenAt  DateTime @updatedAt

  @@unique([entityKey, externalId])
  @@index([entityKey])
}

/// Singleton-style product branding / first-install settings (id = "default")
model AppSettings {
  id              String   @id @default("default")
  setupComplete   Boolean  @default(false)
  companyNameFa   String   @default("")
  companyNameEn   String?
  appNameFa       String   @default("پورتال مدیریتی")
  appNameEn       String   @default("Insight Portal")
  logoPath        String?
  faviconPath     String?
  primaryColor    String   @default("#1e4d7b")
  accentColor     String   @default("#0d7a6f")
  supportEmail    String?
  supportPhone    String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}
